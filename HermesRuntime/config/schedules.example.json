{
  "schedule_version": "schedules_v1",
  "check_interval_seconds": 60,
  "jobs": [
    {
      "job_id": "planning_cycle_hourly",
      "job_type": "run_planning_cycle",
      "enabled": true,
      "schedule_type": "interval",
      "command": "run-planning-cycle",
      "every_minutes": 60,
      "parameters": {
        "max_items": "20"
      }
    },
    {
      "job_id": "planning_cycle_before_nightly",
      "job_type": "run_planning_cycle",
      "enabled": true,
      "schedule_type": "daily",
      "command": "run-planning-cycle",
      "daily_at": "22:45",
      "parameters": {
        "max_items": "20"
      }
    },
    {
      "job_id": "nightly_beta3_research",
      "job_type": "trading_nightly_beta3",
      "enabled": true,
      "schedule_type": "window",
      "command": "run-nightly-beta3",
      "window_start": "23:00",
      "window_end": "05:00",
      "max_runtime_minutes": 360,
      "sleep_seconds": 60,
      "max_idle_iterations": 10
    },
    {
      "job_id": "storage_hygiene",
      "job_type": "storage_hygiene",
      "enabled": true,
      "schedule_type": "daily",
      "command": "cleanup-plan",
      "daily_at": "05:15"
    },
    {
      "job_id": "research_insights",
      "job_type": "research_insights",
      "enabled": true,
      "schedule_type": "daily",
      "command": "research-insights",
      "daily_at": "05:30"
    },
    {
      "job_id": "scan_knowledge_sources",
      "job_type": "scan_knowledge_sources",
      "enabled": true,
      "schedule_type": "daily",
      "command": "scan-knowledge-sources",
      "daily_at": "05:40"
    },
    {
      "job_id": "process_research_queue",
      "job_type": "process_research_queue",
      "enabled": true,
      "schedule_type": "window",
      "command": "process-research-queue",
      "window_start": "23:00",
      "window_end": "05:00",
      "max_runtime_minutes": 60,
      "parameters": {
        "max_items": "50"
      }
    },
    {
      "job_id": "generate_cognitive_insights",
      "job_type": "generate_cognitive_insights",
      "enabled": true,
      "schedule_type": "daily",
      "command": "generate-hypotheses",
      "daily_at": "05:45",
      "parameters": {
        "domain": "trading"
      }
    },
    {
      "job_id": "planning_cycle_after_nightly",
      "job_type": "run_planning_cycle",
      "enabled": true,
      "schedule_type": "daily",
      "command": "run-planning-cycle",
      "daily_at": "05:55",
      "parameters": {
        "max_items": "20"
      }
    },
    {
      "job_id": "process_planned_tasks_after_planning",
      "job_type": "process_planned_tasks",
      "enabled": true,
      "schedule_type": "interval",
      "command": "execute-planned-tasks",
      "every_minutes": 60,
      "parameters": {
        "max_items": "10"
      }
    },
    {
      "job_id": "outcome_feedback_after_planned_tasks",
      "job_type": "evaluate_task_outcomes",
      "enabled": true,
      "schedule_type": "interval",
      "command": "evaluate-task-outcomes",
      "every_minutes": 60,
      "parameters": {
        "max_items": "50"
      }
    },
    {
      "job_id": "health_snapshot",
      "job_type": "health_snapshot",
      "enabled": true,
      "schedule_type": "interval",
      "command": "resource-status",
      "every_minutes": 60
    },
    {
      "job_id": "market_data_refresh",
      "job_type": "market_data_refresh",
      "enabled": false,
      "schedule_type": "daily",
      "command": "download-history",
      "daily_at": "22:30"
    }
  ]
}
