{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermesruntime.local/schemas/ensemble_signal_agent_package.schema.json",
  "title": "Ensemble Signal Agent Package V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "generated_at",
    "package_version",
    "source_system",
    "status",
    "assets",
    "safety_flags",
    "no_auto_trading",
    "human_review_required",
    "broker_orders_enabled",
    "live_trading_enabled",
    "research_only"
  ],
  "properties": {
    "package_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "package_version": { "type": "string", "minLength": 1 },
    "source_system": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "safety_flags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset",
          "readiness",
          "setup_id",
          "setup_name",
          "timeframe",
          "direction",
          "primary_candidate",
          "backup_candidates",
          "confidence_baseline",
          "signal_frequency",
          "entry_logic",
          "exit_logic",
          "stop_loss_logic",
          "take_profit_logic",
          "invalidation_logic",
          "market_regime_tags",
          "session_tags",
          "risk_notes",
          "human_review_required",
          "no_auto_trading",
          "broker_orders_enabled",
          "live_trading_enabled"
        ],
        "properties": {
          "asset": { "type": "string", "minLength": 1 },
          "readiness": {
            "type": "string",
            "enum": ["portfolio_ready", "signal_ready", "setup_ready", "bot_ready", "needs_more_validation", "data_ready_only", "missing_data", "quote_mapping_pending"]
          },
          "setup_id": { "type": "string", "minLength": 1 },
          "setup_name": { "type": "string", "minLength": 1 },
          "timeframe": { "type": "string", "minLength": 1 },
          "direction": { "type": "string", "minLength": 1 },
          "primary_candidate": { "type": "string", "minLength": 1 },
          "backup_candidates": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "confidence_baseline": { "type": "number" },
          "signal_frequency": { "type": "string", "minLength": 1 },
          "entry_logic": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "exit_logic": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "stop_loss_logic": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "take_profit_logic": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "invalidation_logic": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "market_regime_tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "session_tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "risk_notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "human_review_required": { "type": "boolean", "const": true },
          "no_auto_trading": { "type": "boolean", "const": true },
          "broker_orders_enabled": { "type": "boolean", "const": false },
          "live_trading_enabled": { "type": "boolean", "const": false }
        }
      }
    },
    "no_auto_trading": { "type": "boolean", "const": true },
    "human_review_required": { "type": "boolean", "const": true },
    "broker_orders_enabled": { "type": "boolean", "const": false },
    "live_trading_enabled": { "type": "boolean", "const": false },
    "research_only": { "type": "boolean", "const": true }
  }
}
